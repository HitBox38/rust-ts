{
  "//": [
    "Decodable/Encodable impls of external types for the derive(Decodable)/(Encodable) generator (tools/codegen/types.ts,",
    "sets with derive_decodable / derive_encodable). paths: resolved Rust paths (bare names match prelude/std/core/alloc).",
    "decode: call template ($D the decoder, $d0..$dn Decodable fns of the type arguments); encode: call template ($v the",
    "value, $E the encoder, $e0..$en Encodable fns of the type arguments). Their decode_*/encode_* names are imported from",
    "`import` (default: `module`), plus `values` (from `values_import`, default `import`). transparent: the type argument's impl (Box/Rc/Arc/Cell/RefCell/Lrc).",
    "*_nullable: Option of an undefined-able type ({ $: \"Some\", _0 } | undefined, PORTING section 5).",
    "Types of the set itself (derived, manual impl exported by the hand module, newtype_index! #[encodable]) need no entry.",
    "decoders / encoders: the TS type of each derive's decoder (`__D: SpanDecoder` for derive(Decodable), ...). rustc_span's",
    "SpanDecoder / BlobDecoder are ported (src/rustc_span/lib.ts); the rustc_middle / rustc_metadata decoder traits are not yet:",
    "until they are, those derives take the plain rustc_serialize Decoder; switch the entry (and regenerate) when the trait exists.",
    "Encoders stay the plain Encoder (rustc_serialize's Encodable<T> is not generic over the encoder)."
  ],
  "module": "src/rustc_serialize/serialize.ts",
  "decoders": {
    "Decodable_NoContext": { "type": "Decoder", "import": "src/rustc_serialize/serialize.ts" },
    "Decodable": { "type": "SpanDecoder", "import": "src/rustc_span/lib.ts", "note": "upstream: `__D: rustc_span::SpanDecoder`" },
    "BlobDecodable": { "type": "BlobDecoder", "import": "src/rustc_span/lib.ts", "note": "upstream: `__D: rustc_span::BlobDecoder`" },
    "LazyDecodable": { "type": "Decoder", "import": "src/rustc_serialize/serialize.ts", "note": "upstream: `__D: LazyDecoder` (rustc_metadata, not ported yet)" },
    "TyDecodable": { "type": "Decoder", "import": "src/rustc_serialize/serialize.ts", "note": "upstream: `__D: rustc_middle::ty::codec::TyDecoder` (not ported yet)" }
  },
  "encoders": {
    "Encodable_NoContext": { "type": "Encoder", "import": "src/rustc_serialize/serialize.ts" },
    "Encodable": { "type": "Encoder", "import": "src/rustc_serialize/serialize.ts", "note": "upstream: `__E: rustc_span::SpanEncoder` (ported, src/rustc_span/lib.ts); kept `Encoder` because rustc_serialize's `Encodable<T>` is `(v, s: Encoder)`, not generic over the encoder: the SpanEncoder impls (encode_Span, ...) take an `Encoder` and use it as a SpanEncoder" },
    "TyEncodable": { "type": "Encoder", "import": "src/rustc_serialize/serialize.ts", "note": "upstream: `__E: TyEncoder` (not ported yet)" },
    "MetadataEncodable": { "type": "Encoder", "import": "src/rustc_serialize/serialize.ts", "note": "upstream: `EncodeContext` (M5)" }
  },
  "types": [
    { "paths": ["usize"], "decode": "decode_usize($D)", "encode": "encode_usize($v, $E)" },
    { "paths": ["u8"], "decode": "decode_u8($D)", "encode": "encode_u8($v, $E)" },
    { "paths": ["u16"], "decode": "decode_u16($D)", "encode": "encode_u16($v, $E)" },
    { "paths": ["u32"], "decode": "decode_u32($D)", "encode": "encode_u32($v, $E)" },
    { "paths": ["u64"], "decode": "Number(decode_u64($D))", "encode": "encode_u64(BigInt($v), $E)", "note": "generated types map u64 to number (typemap.json, values < 2^53); the impl is bigint" },
    { "paths": ["u128"], "decode": "decode_u128($D)", "encode": "encode_u128($v, $E)" },
    { "paths": ["isize"], "decode": "decode_isize($D)", "encode": "encode_isize($v, $E)" },
    { "paths": ["i8"], "decode": "decode_i8($D)", "encode": "encode_i8($v, $E)" },
    { "paths": ["i16"], "decode": "decode_i16($D)", "encode": "encode_i16($v, $E)" },
    { "paths": ["i32"], "decode": "decode_i32($D)", "encode": "encode_i32($v, $E)" },
    { "paths": ["i64"], "decode": "Number(decode_i64($D))", "encode": "encode_i64(BigInt($v), $E)", "note": "see u64" },
    { "paths": ["i128"], "decode": "decode_i128($D)", "encode": "encode_i128($v, $E)" },
    { "paths": ["bool"], "decode": "decode_bool($D)", "encode": "encode_bool($v, $E)" },
    { "paths": ["char"], "decode": "decode_char($D)", "encode": "encode_char($v, $E)" },
    { "paths": ["String", "std::string::String"], "decode": "decode_String($D)", "encode": "encode_String($v, $E)" },
    { "paths": ["str"], "decode": "decode_String($D)", "encode": "encode_str($v, $E)", "note": "unsized: decoded only behind Box/Rc/Arc/Cow (`Box<str>` decodes a String)" },
    { "paths": ["Cow", "std::borrow::Cow"], "transparent": true, "note": "Cow<str> / Cow<[T]> encode and decode as str / [T] (a String / Vec)" },
    { "paths": ["Option"], "decode": "decode_Option($D, $d0)", "encode": "encode_Option($v, $E, $e0)", "decode_nullable": "decode_Option_some($D, $d0)", "encode_nullable": "encode_Option_some($v, $E, $e0)" },
    { "paths": ["Result"], "decode": "decode_Result($D, $d0, $d1)", "encode": "encode_Result($v, $E, $e0, $e1)" },
    { "paths": ["Vec", "std::vec::Vec"], "decode": "decode_Vec($D, $d0)", "encode": "encode_Vec($v, $E, $e0)" },
    { "paths": ["thin_vec::ThinVec"], "decode": "decode_ThinVec($D, $d0)", "encode": "encode_ThinVec($v, $E, $e0)" },
    { "paths": ["smallvec::SmallVec"], "decode": "decode_SmallVec($D, $d0)", "encode": "encode_SmallVec($v, $E, $e0)" },
    { "paths": ["VecDeque", "std::collections::VecDeque"], "decode": "decode_VecDeque($D, $d0)", "encode": "encode_VecDeque($v, $E, $e0)" },
    { "paths": ["Box", "std::boxed::Box", "Rc", "std::rc::Rc", "Arc", "std::sync::Arc", "rustc_data_structures::sync::Lrc", "Cell", "std::cell::Cell", "RefCell", "std::cell::RefCell"], "transparent": true },
    { "paths": ["PhantomData", "std::marker::PhantomData"], "decode": "decode_PhantomData($D)", "encode": "encode_PhantomData($v, $E)" },
    { "paths": ["std::num::NonZero", "core::num::NonZero"], "decode": "decode_NonZero($D, $d0)", "encode": "encode_NonZero($v, $E, $e0)" },
    { "paths": ["std::path::PathBuf", "PathBuf"], "decode": "decode_PathBuf($D)", "encode": "encode_PathBuf($v, $E)" },
    { "paths": ["std::path::Path", "Path"], "encode": "encode_Path($v, $E)", "note": "unsized: no Decodable" },
    { "paths": ["std::collections::BTreeMap", "BTreeMap"], "decode": "decode_BTreeMap($D, $d0, $d1)", "encode": "encode_BTreeMap($v, $E, $e0, $e1)" },
    { "paths": ["std::collections::BTreeSet", "BTreeSet"], "decode": "decode_BTreeSet($D, $d0)", "encode": "encode_BTreeSet($v, $E, $e0)" },
    { "paths": ["rustc_data_structures::fx::FxHashMap", "std::collections::HashMap", "HashMap", "rustc_data_structures::unord::UnordMap"], "decode": "decode_HashMap($D, $d0, $d1)", "encode": "encode_HashMap($v, $E, $e0, $e1)" },
    { "paths": ["rustc_data_structures::fx::FxHashSet", "std::collections::HashSet", "HashSet", "rustc_data_structures::unord::UnordSet"], "decode": "decode_HashSet($D, $d0)", "encode": "encode_HashSet($v, $E, $e0)" },
    { "paths": ["rustc_data_structures::fx::FxIndexMap", "indexmap::IndexMap"], "decode": "decode_IndexMap($D, $d0, $d1)", "encode": "encode_IndexMap($v, $E, $e0, $e1)" },
    { "paths": ["rustc_data_structures::fx::FxIndexSet", "indexmap::IndexSet"], "decode": "decode_IndexSet($D, $d0)", "encode": "encode_IndexSet($v, $E, $e0)" },
    { "paths": ["rustc_hashes::Hash64"], "decode": "decode_Hash64($D)", "encode": "encode_Hash64($v, $E)" },
    { "paths": ["rustc_hashes::Hash128"], "decode": "decode_Hash128($D)", "encode": "encode_Hash128($v, $E)" },
    { "paths": ["rustc_data_structures::fingerprint::Fingerprint"], "decode": "decode_Fingerprint($D)", "encode": "$E.emit_raw_bytes(Fingerprint.to_le_bytes($v))", "import": "src/rustc_data_structures/fingerprint.ts", "values": ["Fingerprint"], "note": "the Encodable impl (fingerprint.rs:172, `s.emit_raw_bytes(&self.to_le_bytes())`) is rustc-skipped in fingerprint.ts (M5): its body is the encode template" },
    { "paths": ["rustc_data_structures::fingerprint::PackedFingerprint"], "decode": "decode_PackedFingerprint($D)", "import": "src/rustc_data_structures/fingerprint.ts", "note": "Encodable is rustc-skipped (M5)" },

    { "paths": ["rustc_span::RelativeBytePos", "RelativeBytePos"], "decode": "decode_RelativeBytePos($D)", "encode": "encode_RelativeBytePos($v, $E)", "import": "src/rustc_span/lib.ts", "note": "manual impls at rustc_span lib.rs:2738/2744; the type is defined inside impl_pos!, which the typedefs probe does not expand" },
    { "paths": ["rustc_span::BytePos", "BytePos"], "decode": "decode_BytePos($D)", "encode": "encode_BytePos($v, $E)", "import": "src/rustc_span/lib.ts", "note": "manual impls at rustc_span lib.rs:2726/2732; the type is defined inside impl_pos!" },
    { "paths": ["rustc_span::edition::Edition", "rustc_span::Edition"], "decode": "decode_Edition($D)", "encode": "encode_Edition($v, $E)", "import": "src/rustc_span/decodable.gen.ts" }
  ]
}
