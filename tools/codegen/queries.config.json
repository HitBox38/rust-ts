{
  "//": [
    "Configuration of tools/codegen/queries.ts (the `rustc_queries!` declarations generator).",
    "aliases: Rust path prefixes that are re-exports of another path (longest prefix wins); applied before the",
    "  type map / generated-type index lookup. `rustc_hir::def_id` is `pub use rustc_span::def_id::*`, etc.",
    "keys: resolved key type (canonical text, see `typeKey`) -> name of its `QueryKey` impl in",
    "  src/rustc_middle/query/keys.ts (`KEY_<name>`). Key types missing here get `key_unported(..)`.",
    "into_key: key types whose TyCtxt methods take `impl IntoQueryKey<K>` (`maybe_into_query_key!`, query_api.rs:3).",
    "display: `{}` formatting of a resolved type in a `desc` (template, $v = value) + imports (module -> names).",
    "methods: return types (Rust text, resolved in queries.rs's scope) of non-query `TyCtxt` methods a `desc` may call.",
    "fns: free functions a `desc` may call: TS name, module, Rust return type.",
    "tagged_enums: enums whose TS shape is the `$`-tagged object union (match arms test `x.$`); other enums",
    "  matched by a `desc` are string unions (match arms test `x ===`).",
    "Anything a `desc` uses that is not covered here makes that description `unported(..)` (reported)."
  ],
  "aliases": {
    "rustc_hir::def_id": "rustc_span::def_id",
    "rustc_middle::ty::Visibility": "rustc_middle::ty::Visibility",
    "rustc_span::def_id": "rustc_span::def_id",
    "rustc_span::ExpnId": "rustc_span::hygiene::ExpnId",
    "rustc_span::LocalExpnId": "rustc_span::hygiene::LocalExpnId",
    "rustc_span::Span": "rustc_span::Span",
    "rustc_session::Limits": "rustc_session::session::Limits",
    "rustc_hir::def::": "rustc_hir::def::",
    "rustc_hir::OwnerId": "rustc_hir_id::OwnerId",
    "rustc_hir::ItemLocalId": "rustc_hir_id::ItemLocalId",
    "rustc_middle::lint::LintExpectation": "rustc_middle::lint::LintExpectation",
    "rustc_hir::definitions": "rustc_hir_id::definitions",
    "rustc_middle::ty::Instance": "rustc_middle::ty::instance::Instance",
    "rustc_middle::ty::InstanceKind": "rustc_middle::ty::instance::InstanceKind",
    "rustc_middle::ty::ShimKind": "rustc_middle::ty::instance::ShimKind",
    "rustc_middle::ty::VtblEntry": "rustc_middle::ty::vtable::VtblEntry",
    "rustc_middle::mir::ConstQualifs": "rustc_middle::mir::query::ConstQualifs",
    "rustc_middle::mir::CoroutineLayout": "rustc_middle::mir::query::CoroutineLayout",
    "rustc_middle::mir::ConstValue": "rustc_middle::mir::consts::ConstValue",
    "rustc_middle::mir::ConstAlloc": "rustc_middle::mir::consts::ConstAlloc",
    "rustc_middle::mir::interpret::EvalToAllocationRawResult": "rustc_middle::mir::interpret::error::EvalToAllocationRawResult",
    "rustc_middle::mir::interpret::EvalStaticInitializerRawResult": "rustc_middle::mir::interpret::error::EvalStaticInitializerRawResult",
    "rustc_middle::mir::interpret::EvalToConstValueResult": "rustc_middle::mir::interpret::error::EvalToConstValueResult",
    "rustc_middle::mir::interpret::EvalToValTreeResult": "rustc_middle::mir::interpret::error::EvalToValTreeResult"
  },
  "keys": {
    "()": "unit",
    "rustc_span::def_id::DefId": "DefId",
    "rustc_middle::ty::instance::Instance": "Instance",
    "rustc_middle::ty::instance::InstanceKind": "InstanceKind",
    "rustc_middle::ty::instance::ShimKind": "ShimKind",
    "rustc_span::def_id::LocalDefId": "LocalDefId",
    "rustc_span::def_id::CrateNum": "CrateNum",
    "rustc_hir_id::OwnerId": "OwnerId",
    "rustc_span::def_id::ModId": "ModId",
    "rustc_span::def_id::LocalModId": "LocalModId",
    "rustc_span::Symbol": "Symbol",
    "Option<rustc_span::Symbol>": "Option_Symbol",
    "(rustc_span::def_id::DefId, rustc_span::def_id::DefId)": "DefId_DefId",
    "(rustc_span::def_id::CrateNum, rustc_span::def_id::DefId)": "CrateNum_DefId",
    "std::ffi::OsStr": "OsStr",
    "rustc_middle::ty::Ty": "Ty",
    "(rustc_middle::ty::Ty, Option<rustc_middle::ty::ExistentialTraitRef>)": "Ty_Option_ExistentialTraitRef",
    "rustc_middle::ty::fast_reject::SimplifiedType": "SimplifiedType",
    "(rustc_span::def_id::DefId, rustc_span::Ident)": "DefId_Ident",
    "(rustc_span::def_id::LocalDefId, rustc_span::def_id::LocalDefId, rustc_span::Ident)": "LocalDefId_LocalDefId_Ident",
    "(rustc_span::def_id::CrateNum, rustc_middle::ty::fast_reject::SimplifiedType)": "CrateNum_SimplifiedType",
    "(rustc_span::def_id::DefId, rustc_middle::ty::SizedTraitKind)": "DefId_SizedTraitKind",
    "rustc_middle::ty::GenericArgsRef": "GenericArgsRef",
    "(rustc_span::def_id::DefId, rustc_middle::ty::GenericArgsRef)": "DefId_GenericArgsRef",
    "rustc_middle::ty::TraitRef": "TraitRef",
    "(rustc_middle::ty::Ty, rustc_middle::ty::Ty)": "Ty_Ty",
    "(rustc_middle::ty::Predicate, rustc_middle::traits::WellFormedLoc)": "Predicate_WellFormedLoc",
    "rustc_middle::ty::Clauses": "Clauses",
    "rustc_middle::ty::AliasTyKind": "AliasTyKind",
    "(rustc_middle::traits::solve::CanonicalInput, usize)": "CanonicalInput_usize",
    "rustc_middle::ty::LitToConstInput": "LitToConstInput",
    "rustc_middle::ty::Value": "Value",
    "rustc_middle::ty::PseudoCanonicalInput<rustc_middle::ty::Ty>": "PseudoCanonicalInput_Ty",
    "rustc_middle::ty::PseudoCanonicalInput<rustc_middle::ty::GenericArg>": "PseudoCanonicalInput_GenericArg",
    "rustc_middle::ty::PseudoCanonicalInput<rustc_middle::ty::TraitRef>": "PseudoCanonicalInput_TraitRef",
    "rustc_middle::ty::PseudoCanonicalInput<(rustc_span::def_id::DefId, rustc_middle::ty::GenericArgsRef)>": "PseudoCanonicalInput_DefId_GenericArgsRef",
    "(rustc_middle::ty::AdtDef, rustc_middle::ty::GenericArgsRef)": "AdtDef_GenericArgsRef",
    "rustc_middle::ty::PseudoCanonicalInput<(rustc_middle::ty::AdtDef, rustc_middle::ty::GenericArgsRef)>": "PseudoCanonicalInput_AdtDef_GenericArgsRef",
    "rustc_middle::ty::PseudoCanonicalInput<rustc_middle::mir::interpret::GlobalId>": "PseudoCanonicalInput_GlobalId",
    "rustc_middle::ty::PseudoCanonicalInput<(rustc_middle::ty::PolyFnSig, rustc_middle::ty::List<rustc_middle::ty::Ty>)>": "PseudoCanonicalInput_PolyFnSig_List_Ty",
    "rustc_middle::ty::PseudoCanonicalInput<(rustc_middle::ty::instance::Instance, rustc_middle::ty::List<rustc_middle::ty::Ty>)>": "PseudoCanonicalInput_Instance_List_Ty",
    "rustc_middle::traits::query::CanonicalPredicateGoal": "CanonicalPredicateGoal",
    "(rustc_middle::traits::query::CanonicalImpliedOutlivesBoundsGoal, bool)": "CanonicalImpliedOutlivesBoundsGoal_bool",
    "rustc_middle::traits::query::CanonicalMethodAutoderefStepsGoal": "CanonicalMethodAutoderefStepsGoal",
    "rustc_middle::traits::query::CanonicalAliasGoal": "CanonicalAliasGoal",
    "rustc_middle::traits::query::CanonicalDropckOutlivesGoal": "CanonicalDropckOutlivesGoal",
    "rustc_middle::traits::query::CanonicalTypeOpAscribeUserTypeGoal": "CanonicalTypeOpAscribeUserTypeGoal",
    "rustc_middle::traits::query::CanonicalTypeOpProvePredicateGoal": "CanonicalTypeOpProvePredicateGoal",
    "rustc_middle::traits::query::CanonicalTypeOpNormalizeGoal<rustc_middle::ty::Ty>": "CanonicalTypeOpNormalizeGoal_Ty",
    "rustc_middle::traits::query::CanonicalTypeOpNormalizeGoal<rustc_middle::ty::Clause>": "CanonicalTypeOpNormalizeGoal_Clause",
    "rustc_middle::traits::query::CanonicalTypeOpNormalizeGoal<rustc_middle::ty::PolyFnSig>": "CanonicalTypeOpNormalizeGoal_PolyFnSig",
    "rustc_middle::traits::query::CanonicalTypeOpNormalizeGoal<rustc_middle::ty::FnSig>": "CanonicalTypeOpNormalizeGoal_FnSig"
  },
  "into_key": {
    "rustc_span::def_id::DefId": "into_query_key_DefId",
    "rustc_span::def_id::LocalDefId": "into_query_key_LocalDefId"
  },
  "display": {
    "String": { "ts": "$v" },
    "str": { "ts": "$v" },
    "rustc_span::Symbol": { "ts": "display_Symbol($v)", "imports": { "src/rustc_span/symbol.ts": ["display_Symbol"] } },
    "rustc_span::Ident": { "ts": "display_Ident($v)", "imports": { "src/rustc_span/symbol.ts": ["display_Ident"] } },
    "rustc_span::def_id::CrateNum": { "ts": "display_CrateNum($v)", "imports": { "src/rustc_span/def_id.ts": ["display_CrateNum"] } },
    "rustc_middle::ty::Ty": { "ts": "display_Ty($v)", "imports": { "src/rustc_middle/ty/print/pretty.ts": ["display_Ty"] } },
    "rustc_middle::ty::instance::Instance": { "ts": "display_Instance($v)", "imports": { "src/rustc_middle/ty/instance.ts": ["display_Instance"] } }
  },
  "methods": {
    "def_path_str": "String",
    "hir_ty_param_name": "Symbol"
  },
  "fns": {
    "describe_as_module": { "ts": "describe_as_module", "module": "src/rustc_middle/queries.ts", "ret": "String" }
  },
  "tagged_enums": ["rustc_hir::def::DefKind"]
}
