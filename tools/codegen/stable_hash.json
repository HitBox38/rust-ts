{
  "//": [
    "StableHash impls of external types for the derive(StableHash) generator (tools/codegen/types.ts, sets with",
    "derive_stable_hash). paths: resolved Rust paths (bare names match prelude/std/core/alloc). stable_hash: call",
    "template ($v value, $hcx / $h context and hasher, $s0..$sn StableHash fns of the type arguments); its",
    "stable_hash_* names are imported from `import` (default: `module`). transparent: the type argument's impl",
    "(Box/Rc/Arc). u8_seq: a u8 element uses the [u8] impl. Types of the set itself (derived, manual impl, or",
    "newtype_index! #[stable_hash]) never need an entry."
  ],
  "module": "src/rustc_data_structures/stable_hash.ts",
  "types": [
    { "paths": ["u8"], "stable_hash": "stable_hash_u8($v, $hcx, $h)" },
    { "paths": ["u16"], "stable_hash": "stable_hash_u16($v, $hcx, $h)" },
    { "paths": ["u32"], "stable_hash": "stable_hash_u32($v, $hcx, $h)" },
    { "paths": ["usize"], "stable_hash": "stable_hash_usize($v, $hcx, $h)" },
    { "paths": ["u64"], "stable_hash": "stable_hash_u64(BigInt($v), $hcx, $h)", "note": "generated types map u64 to number (typemap.json); hand types may use bigint" },
    { "paths": ["u128"], "stable_hash": "stable_hash_u128($v, $hcx, $h)" },
    { "paths": ["i8"], "stable_hash": "stable_hash_i8($v, $hcx, $h)" },
    { "paths": ["i16"], "stable_hash": "stable_hash_i16($v, $hcx, $h)" },
    { "paths": ["i32"], "stable_hash": "stable_hash_i32($v, $hcx, $h)" },
    { "paths": ["isize"], "stable_hash": "stable_hash_isize($v, $hcx, $h)" },
    { "paths": ["i64"], "stable_hash": "stable_hash_i64(BigInt($v), $hcx, $h)", "note": "see u64" },
    { "paths": ["i128"], "stable_hash": "stable_hash_i128($v, $hcx, $h)" },
    { "paths": ["bool"], "stable_hash": "stable_hash_bool($v, $hcx, $h)" },
    { "paths": ["char"], "stable_hash": "stable_hash_char($v, $hcx, $h)" },
    { "paths": ["f32"], "stable_hash": "stable_hash_f32($v, $hcx, $h)" },
    { "paths": ["f64"], "stable_hash": "stable_hash_f64($v, $hcx, $h)" },
    { "paths": ["str"], "stable_hash": "stable_hash_str($v, $hcx, $h)" },
    { "paths": ["String"], "stable_hash": "stable_hash_String($v, $hcx, $h)" },
    { "paths": ["std::cmp::Ordering", "core::cmp::Ordering", "Ordering"], "stable_hash": "stable_hash_Ordering($v, $hcx, $h)" },
    { "paths": ["Option"], "stable_hash": "stable_hash_Option($v, $hcx, $h, $s0)", "stable_hash_nullable": "stable_hash_Option_some($v, $hcx, $h, $s0)" },
    { "paths": ["Result"], "stable_hash": "stable_hash_Result($v, $hcx, $h, $s0, $s1)" },
    { "paths": ["Vec"], "stable_hash": "stable_hash_Vec($v, $hcx, $h, $s0)", "u8_seq": true },
    { "paths": ["thin_vec::ThinVec"], "stable_hash": "stable_hash_ThinVec($v, $hcx, $h, $s0)", "u8_seq": true },
    { "paths": ["Box", "std::boxed::Box", "Rc", "std::rc::Rc", "Arc", "std::sync::Arc", "rustc_data_structures::sync::Lrc"], "transparent": true },
    { "paths": ["PhantomData", "std::marker::PhantomData"], "stable_hash": "stable_hash_PhantomData($v, $hcx, $h)" },
    { "paths": ["std::num::NonZero", "core::num::NonZero"], "stable_hash": "stable_hash_NonZero($v, $hcx, $h, $s0)" },
    { "paths": ["indexmap::IndexMap", "rustc_data_structures::fx::FxIndexMap"], "stable_hash": "stable_hash_IndexMap($v, $hcx, $h, $s0, $s1)" },
    { "paths": ["indexmap::IndexSet", "rustc_data_structures::fx::FxIndexSet"], "stable_hash": "stable_hash_IndexSet($v, $hcx, $h, $s0)" },
    { "paths": ["rustc_index::IndexVec", "rustc_index::vec::IndexVec"], "stable_hash": "stable_hash_IndexVec($v, $hcx, $h, $s1)" },
    { "paths": ["std::path::PathBuf", "PathBuf"], "stable_hash": "stable_hash_PathBuf($v, $hcx, $h)" },
    { "paths": ["std::path::Path", "Path"], "stable_hash": "stable_hash_Path($v, $hcx, $h)" },
    { "paths": ["rustc_hashes::Hash64"], "stable_hash": "stable_hash_Hash64($v, $hcx, $h)" },
    { "paths": ["rustc_hashes::Hash128"], "stable_hash": "stable_hash_Hash128($v, $hcx, $h)" },
    { "paths": ["rustc_data_structures::fingerprint::Fingerprint"], "stable_hash": "stable_hash_Fingerprint($v, $hcx, $h)" },

    { "paths": ["rustc_span::RelativeBytePos", "RelativeBytePos"], "stable_hash": "stable_hash_u32($v, $hcx, $h)", "note": "`#[derive(StableHash)] pub struct RelativeBytePos(pub u32)` inside impl_pos! (lib.rs), which the typedefs probe does not expand" },
    { "paths": ["rustc_span::Span", "rustc_span::span_encoding::Span"], "stable_hash": "stable_hash_Span($v, $hcx, $h)", "import": "src/rustc_span/lib.ts" },
    { "paths": ["rustc_span::Symbol", "rustc_span::symbol::Symbol"], "stable_hash": "stable_hash_Symbol($v, $hcx, $h)", "import": "src/rustc_span/symbol.ts" },
    { "paths": ["rustc_span::ByteSymbol", "rustc_span::symbol::ByteSymbol"], "stable_hash": "stable_hash_ByteSymbol($v, $hcx, $h)", "import": "src/rustc_span/symbol.ts" },
    { "paths": ["rustc_span::Ident", "rustc_span::symbol::Ident"], "stable_hash": "stable_hash_Ident($v, $hcx, $h)", "import": "src/rustc_span/stable_hash.gen.ts" },
    { "paths": ["rustc_span::ErrorGuaranteed"], "stable_hash": "stable_hash_ErrorGuaranteed($v, $hcx, $h)", "import": "src/rustc_span/stable_hash.gen.ts" },
    { "paths": ["rustc_span::source_map::Spanned", "rustc_span::Spanned"], "stable_hash": "stable_hash_Spanned($v, $hcx, $h, $s0)", "import": "src/rustc_span/stable_hash.gen.ts" },
    { "paths": ["rustc_ast_ir::IntTy", "rustc_type_ir::IntTy", "rustc_ast::IntTy", "rustc_ast::ast::IntTy"], "stable_hash": "stable_hash_IntTy($v, $hcx, $h)", "import": "src/rustc_ast_ir/stable_hash.gen.ts" },
    { "paths": ["rustc_ast_ir::UintTy", "rustc_type_ir::UintTy", "rustc_ast::UintTy", "rustc_ast::ast::UintTy"], "stable_hash": "stable_hash_UintTy($v, $hcx, $h)", "import": "src/rustc_ast_ir/stable_hash.gen.ts" },
    { "paths": ["rustc_ast_ir::FloatTy", "rustc_type_ir::FloatTy", "rustc_ast::FloatTy", "rustc_ast::ast::FloatTy"], "stable_hash": "stable_hash_FloatTy($v, $hcx, $h)", "import": "src/rustc_ast_ir/stable_hash.gen.ts" },
    { "paths": ["rustc_ast_ir::Mutability", "rustc_type_ir::Mutability", "rustc_ast::Mutability", "rustc_ast::ast::Mutability"], "stable_hash": "stable_hash_Mutability($v, $hcx, $h)", "import": "src/rustc_ast_ir/stable_hash.gen.ts" },
    { "paths": ["rustc_span::edition::Edition", "rustc_span::Edition"], "stable_hash": "stable_hash_Edition($v, $hcx, $h)", "import": "src/rustc_span/stable_hash.gen.ts" },
    { "paths": ["rustc_span::def_id::DefId", "rustc_span::DefId", "rustc_hir::def_id::DefId"], "stable_hash": "stable_hash_DefId($v, $hcx, $h)", "import": "src/rustc_span/def_id.ts" },
    { "paths": ["rustc_span::def_id::LocalDefId", "rustc_hir::def_id::LocalDefId"], "stable_hash": "stable_hash_LocalDefId($v, $hcx, $h)", "import": "src/rustc_span/def_id.ts" },
    { "paths": ["rustc_span::def_id::CrateNum", "rustc_hir::def_id::CrateNum"], "stable_hash": "stable_hash_CrateNum($v, $hcx, $h)", "import": "src/rustc_span/def_id.ts" },
    { "paths": ["rustc_span::hygiene::ExpnId", "rustc_span::ExpnId"], "stable_hash": "stable_hash_ExpnId($v, $hcx, $h)", "import": "src/rustc_span/hygiene.ts" },
    { "paths": ["rustc_span::hygiene::SyntaxContext", "rustc_span::SyntaxContext"], "stable_hash": "stable_hash_SyntaxContext($v, $hcx, $h)", "import": "src/rustc_span/hygiene.ts" },
    { "paths": ["rustc_span::hygiene::LocalExpnId", "rustc_span::LocalExpnId"], "stable_hash": "stable_hash_LocalExpnId($v, $hcx, $h)", "import": "src/rustc_span/hygiene.ts" }
  ]
}
