{
  "//": [
    "IntoDiagArg impls and Display of Rust types, for the derive(Diagnostic)/derive(Subdiagnostic) generator",
    "(tools/codegen/diagnostics.ts via types.ts). paths: resolved Rust paths (same rules as typemap.json paths;",
    "references are looked through: `&'a str` uses `str`, `&Path` uses `std::path::Path`).",
    "into_diag_arg: expression of a `(self: T, path: MutRef<PathBuf | undefined>) => DiagArgValue` function",
    "  (`diag.arg(name, IntoDiagArg.of(v, <fn>))`, `sub_args.set(name, <fn>(v, diag.long_ty_path()))`).",
    "display: expression template for `format!(\"{x}\")` of a value ($v) in suggestion code.",
    "imports: repo-relative module -> names used by the expressions.",
    "Types without an entry are emitted as `unported` and listed in the types report (missing_diag_arg).",
    "Local types with a hand-written `impl IntoDiagArg` use `<T>_into_diag_arg` from the hand module."
  ],
  "types": [
    { "paths": ["String"], "into_diag_arg": "String_into_diag_arg", "display": "$v", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["String_into_diag_arg"] } },
    { "paths": ["str"], "into_diag_arg": "str_into_diag_arg", "display": "$v", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["str_into_diag_arg"] } },
    { "paths": ["std::borrow::Cow", "Cow"], "into_diag_arg": "Cow_into_diag_arg", "display": "$v", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["Cow_into_diag_arg"] }, "note": "Cow<'_, str> only" },
    { "paths": ["bool"], "into_diag_arg": "bool_into_diag_arg", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["bool_into_diag_arg"] } },
    { "paths": ["char"], "into_diag_arg": "char_into_diag_arg", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["char_into_diag_arg"] } },
    { "paths": ["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "i128", "u128", "isize", "usize"], "into_diag_arg": "number_into_diag_arg", "display": "String($v)", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["number_into_diag_arg"] } },
    { "paths": ["rustc_span::Symbol", "rustc_span::symbol::Symbol"], "into_diag_arg": "Symbol_into_diag_arg", "display": "display_Symbol($v)", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["Symbol_into_diag_arg"], "src/rustc_span/symbol.ts": ["display_Symbol"] } },
    { "paths": ["rustc_span::Ident", "rustc_span::symbol::Ident"], "into_diag_arg": "into_diag_arg_using_display(display_Ident)", "display": "display_Ident($v)", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["into_diag_arg_using_display"], "src/rustc_span/symbol.ts": ["display_Ident"] } },
    { "paths": ["rustc_span::edition::Edition", "rustc_span::Edition"], "into_diag_arg": "into_diag_arg_using_display(display_Edition)", "display": "display_Edition($v)", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["into_diag_arg_using_display"], "src/rustc_span/edition.ts": ["display_Edition"] } },
    { "paths": ["std::path::Path", "Path"], "into_diag_arg": "Path_into_diag_arg", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["Path_into_diag_arg"] } },
    { "paths": ["std::path::PathBuf", "PathBuf"], "into_diag_arg": "PathBuf_into_diag_arg", "imports": { "src/rustc_error_messages/diagnostic_impls.ts": ["PathBuf_into_diag_arg"] } }
  ]
}
