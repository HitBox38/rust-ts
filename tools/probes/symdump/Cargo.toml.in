# Template: scripts/probes.ts substitutes @UPSTREAM@/@SRC@/@RELEASE@ and builds this in $RUST_TS_DATA/probes.
# rustc_span is a path dep on the pinned upstream checkout. Its `symbols!` macro needs
# CFG_RELEASE at build time (`env` below; @RELEASE@ is UPSTREAM.json `release`), and rustc_macros'
# build script refuses to run without RUSTC_BOOTSTRAP.
# Transitive registry deps of rustc_span are resolved by cargo (no lockfile is shipped); they do not
# influence the symbol table.
[package]
name = "symdump"
version = "0.0.0"
edition = "2024"
publish = false
build = "@SRC@/build.rs"

# `symbol-rs` is read by build.rs (it parses the `symbols!` invocation for the kw/sym constant
# names); `env` by scripts/probes.ts (build environment).
[package.metadata.rust-ts]
symbol-rs = "@UPSTREAM@/compiler/rustc_span/src/symbol.rs"
env = { RUSTC_BOOTSTRAP = "1", CFG_RELEASE = "@RELEASE@" }

[[bin]]
name = "symdump"
path = "@SRC@/main.rs"

[dependencies]
rustc_span = { path = "@UPSTREAM@/compiler/rustc_span" }

[workspace]
