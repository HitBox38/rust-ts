# Template: scripts/probes.ts substitutes @SRC@ and builds this in $RUST_TS_DATA/probes.
#
# A rustc-dev probe (lane passes-reachable; see tools/probes/ckdump/Cargo.toml.in and the header of
# scripts/probes.ts): it links the pinned nightly's own compiler crates through
# `#![feature(rustc_private)]` + `extern crate`, so it needs the rustc-dev component.
[package]
name = "optshash"
version = "0.0.0"
edition = "2024"
publish = false

[package.metadata.rust-ts]
rustc_dev = true

[[bin]]
name = "optshash"
path = "@SRC@/main.rs"

[workspace]
