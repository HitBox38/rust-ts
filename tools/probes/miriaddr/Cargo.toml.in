# Template: scripts/probes.ts substitutes @SRC@ and builds this in $RUST_TS_DATA/probes.
#
# Oracle probe for src/miri/alloc_addresses/{address_generator,reuse_pool,mod}.ts (lane miri-alloc; registered by lane
# harness-w36 from docs/handoff/miri-alloc-probe/): its stdout is src/miri/alloc_addresses/addresses.oracle.txt, byte
# for byte (scripts/probe-fixtures.test.ts). Miri's address assignment at the pin, driven by Miri's rand (rand 0.10.1
# through upstream's Cargo.lock, `lockfile = "upstream"`).
[package]
name = "miriaddr"
version = "0.0.0"
edition = "2024"
publish = false

[package.metadata.rust-ts]
lockfile = "upstream"

[[bin]]
name = "miriaddr"
path = "@SRC@/main.rs"

[dependencies]
rand = "=0.10.1"

[workspace]
