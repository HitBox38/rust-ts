# Template: scripts/probes.ts substitutes @SRC@ and builds this in $RUST_TS_DATA/probes.
#
# A rustc-dev probe (see tools/probes/tokdump/Cargo.toml.in and the header of scripts/probes.ts):
# it links the pinned nightly's own compiler crates (`rustc_resolve::rustdoc` with its re-exported
# `pulldown_cmark`, `rustc_ast`, `rustc_span`) through `#![feature(rustc_private)]` + `extern crate`.
[package]
name = "rustdoc"
version = "0.0.0"
edition = "2024"
publish = false

[package.metadata.rust-ts]
rustc_dev = true

[[bin]]
name = "rustdoc"
path = "@SRC@/main.rs"

[workspace]
