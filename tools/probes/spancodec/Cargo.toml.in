# Template: scripts/probes.ts substitutes @SRC@ and builds this in $RUST_TS_DATA/probes.
#
# A rustc-dev probe (see tools/probes/tokdump/Cargo.toml.in and the header of scripts/probes.ts):
# it links the pinned nightly's own `rustc_span` (SpanEncoder/SpanDecoder/BlobDecoder, hygiene
# encode/decode), `rustc_serialize` and `rustc_hashes` through `#![feature(rustc_private)]` +
# `extern crate`.
[package]
name = "spancodec"
version = "0.0.0"
edition = "2024"
publish = false

[package.metadata.rust-ts]
rustc_dev = true

[[bin]]
name = "spancodec"
path = "@SRC@/main.rs"

[workspace]
