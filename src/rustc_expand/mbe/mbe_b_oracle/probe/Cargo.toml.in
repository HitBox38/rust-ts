# The mbe-b lane's rustc-dev probe (tools/probes template format, so root can move it to
# tools/probes/mbeprobe unchanged). Built by hand in the lane (scratch dir $RUST_TS_DATA/tmp/mbe-b/probe):
#   RUSTC_BOOTSTRAP=1 CARGO_ENCODED_RUSTFLAGS=-C<US>link-arg=-Wl,-rpath,<sysroot>/lib \
#   cargo +nightly-2026-10-11 build --release
# Its outputs are committed as a fixture (src/rustc_expand/mbe/mbe_b_oracle/out.json, written by
# src/rustc_expand/mbe/mbe_b_oracle/gen.ts); the tests replay it and do not need the probe.
[package]
name = "mbeprobe"
version = "0.0.0"
edition = "2024"
publish = false

[package.metadata.rust-ts]
rustc_dev = true

[[bin]]
name = "mbeprobe"
path = "@SRC@/main.rs"

[workspace]
