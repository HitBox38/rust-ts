 "src": "#![feature(no_core, decl_macro)]\n#![no_core]\n#![crate_type = \"lib\"]\n\nmacro_rules! inner {\n    () => {\n        struct Inner;\n    };\n}\n\nmacro_rules! outer {\n    ($n:ident) => {\n        inner!();\n        struct $n;\n    };\n}\n\nouter!(A);\n\nmacro_rules! nothing {\n    () => {};\n}\n\nmacro_rules! dup {\n    ($i:item) => {\n        $i\n        $i\n    };\n}\n\ndup!(nothing! {});\n\nmod m {\n    macro_rules! in_mod {\n        ($e:expr) => {\n            fn f() -> u8 {\n                $e\n            }\n        };\n    }\n    in_mod!(5);\n\n    pub macro opaque($name:ident) {\n        struct Hidden;\n        pub struct $name;\n    }\n    opaque!(Visible);\n\n    macro_rules! defines_mac {\n        () => {\n            macro_rules! defined {\n                () => {\n                    struct FromDefined;\n                };\n            }\n            defined!();\n        };\n    }\n    defines_mac!();\n}\n\nmacro_rules! uses_crate {\n    () => {\n        $crate::m::Visible\n    };\n}\n\nfn g() -> m::Visible {\n    uses_crate!()\n}\n\n// é 漢: multi-byte chars before the last invocation\nfn h() {}\nmod z {\n    outer!(B);\n}\n",
